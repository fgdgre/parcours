  {
    "id": "g2",
    "day": 2,
    "topic": "Link words: pour / de / nothing",
    "rule": "Use 'pour' only for purpose ('in order to'): je suis ici pour parler. Use 'de' in the c'est-pattern after possible/difficile: c'est possible de dormir. After aller/vouloir/pouvoir + another verb, put NOTHING between them.",
    "examples": [
      {
        "fr": "Je suis ici pour parler français.",
        "en": "I'm here to speak French."
      },
      {
        "fr": "Ce n'est pas possible de voler.",
        "en": "It's not possible to fly."
      },
      {
        "fr": "Je vais parler.",
        "en": "I'm going to speak."
      },
      {
        "fr": "Je viens de manger.",
        "en": "I just ate. (venir de = just did)"
      }
    ],
    "practice": [
      {
        "prompt": "I'm here to work.",
        "answer": [
          "je suis ici pour travailler"
        ]
      },
      {
        "prompt": "It's difficult to understand French. (difficile, comprendre)",
        "answer": [
          "c'est difficile de comprendre le français",
          "il est difficile de comprendre le français"
        ]
      },
      {
        "prompt": "I'm going to sleep.",
        "answer": [
          "je vais dormir"
        ]
      },
      {
        "prompt": "I work to learn French. (apprendre)",
        "answer": [
          "je travaille pour apprendre le français"
        ]
      },
      {
        "prompt": "It's not possible to work tonight.",
        "answer": [
          "ce n'est pas possible de travailler ce soir",
          "il n'est pas possible de travailler ce soir"
        ]
      },
      {
        "prompt": "I'm not going to speak.",
        "answer": [
          "je ne vais pas parler"
        ]
      },
      {
        "prompt": "I just ate.",
        "answer": [
          "je viens de manger"
        ]
      },
      {
        "prompt": "I'd like to eat something.",
        "answer": [
          "je voudrais manger quelque chose"
        ]
      }
