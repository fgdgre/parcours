[
  {
    "id": "g1",
    "day": 1,
    "topic": "Two verbs together",
    "rule": "After vouloir, pouvoir, aller (and je voudrais), only the FIRST verb is conjugated. The second stays in its plain dictionary (infinitive) form with nothing between the verbs — no 'de', no 'pour', no ending change. This holds no matter how many words separate them.",
    "examples": [
      {
        "fr": "Je veux fermer la porte.",
        "en": "I want to close the door."
      },
      {
        "fr": "Je voudrais parler français.",
        "en": "I'd like to speak French."
      },
      {
        "fr": "Je vais manger maintenant.",
        "en": "I'm going to eat now."
      },
      {
        "fr": "Je peux venir demain.",
        "en": "I can come tomorrow."
      }
    ],
    "practice": [
      {
        "prompt": "I want to eat.",
        "answer": [
          "je veux manger"
        ]
      },
      {
        "prompt": "I'd like to close the window.",
        "answer": [
          "je voudrais fermer la fenêtre"
        ]
      },
      {
        "prompt": "I'm going to speak French.",
        "answer": [
          "je vais parler français"
        ]
      },
      {
        "prompt": "I can come with you.",
        "answer": [
          "je peux venir avec toi",
          "je peux venir avec vous"
        ]
      },
      {
        "prompt": "He wants to sleep. (dormir)",
        "answer": [
          "il veut dormir"
        ]
      },
      {
        "prompt": "I'm not going to work.",
        "answer": [
          "je ne vais pas travailler"
        ]
      },
      {
        "prompt": "I want to speak with you.",
        "answer": [
          "je veux parler avec toi",
          "je veux parler avec vous"
        ]
      },
      {
        "prompt": "She's going to eat something.",
        "answer": [
          "elle va manger quelque chose"
        ]
      }
    ]
